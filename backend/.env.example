# Application Configuration
PROJECT_NAME="FHN Document Ops API"
API_V1_STR="/api/v1"

# Security (Change in Production)
SECRET_KEY="supersecretkey-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days
DEFAULT_LINK_EXPIRATION_DAYS=7

# -----------------------------------------------------
# Database Configuration
# -----------------------------------------------------
# While in the office network without DB access, set this to True.
# It will use a local SQLite file (fhn_mock.db) instead of PostgreSQL.
USE_MOCK_DB=True

# When you get access to PostgreSQL (or MSSQL), set USE_MOCK_DB=False
# and uncomment/update the connection string below.
# DATABASE_URL="postgresql+asyncpg://user:password@hostname:5432/dbname"

# -----------------------------------------------------
# Azure Blob Storage Configuration
# -----------------------------------------------------
# While in the office network without Azure access, set this to True.
# Uploading documents will simulate a successful upload and return a mock URL.
USE_MOCK_STORAGE=True

# When you get access, set USE_MOCK_STORAGE=False and provide the connection string.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="documents"

# -----------------------------------------------------
# Azure Document Intelligence & Foundry Configuration
# -----------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://your-doc-intel-endpoint.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="your_api_key_here"
AZURE_FOUNDRY_URL="https://your-foundry-endpoint"

# -----------------------------------------------------
# Kafka & Celery Configuration
# -----------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_UPLOAD_TOPIC="fhn.docops.upload"
CELERY_BROKER_URL="redis://localhost:6379/0"
